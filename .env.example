# Copy to .env and fill in. .env is git-ignored.

# Nominatim / OpenStreetMap geocoding requires a descriptive User-Agent per their
# usage policy (include a contact address). Used by excel_pipeline/geocode_sites.py.
GEOCODER_USER_AGENT=fleet-distance-dashboard/1.0 (contact: you@example.com)

# Default password applied to the protected "employee edition" workbook produced by
# reimbursement_workflow/scripts/build_calculator.py --employee-edition
EMPLOYEE_EDITION_PASSWORD=change-me
